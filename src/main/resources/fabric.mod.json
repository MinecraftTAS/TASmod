{
	"schemaVersion": 1,
	"id": "tasmod",
	"version": "${mod_version}",
	"name": "${name}",
	"description": "${mod_description}",
	"authors": ["Scribble", "Pancake"],
	"contributors": ["tr7zw", "cittyinthecloud", "forester302"],
	"contact": {
		"homepage": "${mod_url}",
		"sources": "${mod_sources}",
		"issues": "${mod_sources}/issues",
		"email": "${mod_email}"
	},

	"license": "GPLv3",
	"accessWidener": "tasmod.accesswidener",
	"icon": "assets/tasmod/textures/potion.png",
	"entrypoints": {
		"main": [
			"com.minecrafttas.tasmod.TASmod"
		],
		"client": [
			"com.minecrafttas.tasmod.TASmodClient"
		]
	},
	"mixins": [
		"tasmod.mixin.json",
		"mctcommon.mixin.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"custom": {
		"mc-publish": {
			"modrinth": "g0TxtOPk",
			"curseforge": "434702"
		}
	}
